// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  previewFeatures = ["postgresqlExtensions"]
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  extensions = [vector]
}

enum Role {
  ADMIN
  PLANNER
}

enum ConversationStatus {
  BUILDING
  CONFIRMED
  SIZED
}

enum MessageRole {
  USER
  ASSISTANT
}

enum SignalType {
  LOCATION
  TRANSACTION
  CONSUMER_GRAPH
}

model User {
  id            String         @id @default(uuid())
  email         String         @unique
  passwordHash  String
  role          Role           @default(PLANNER)
  createdAt     DateTime       @default(now())
  conversations Conversation[]
}

model Conversation {
  id        String             @id @default(uuid())
  userId    String
  title     String?
  status    ConversationStatus @default(BUILDING)
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt
  user      User               @relation(fields: [userId], references: [id])
  messages  Message[]
  signals   Signal[]
  estimate  AudienceEstimate?
}

model Message {
  id             String       @id @default(uuid())
  conversationId String
  role           MessageRole
  content        String
  createdAt      DateTime     @default(now())
  conversation   Conversation @relation(fields: [conversationId], references: [id])
}

model Signal {
  id             String       @id @default(uuid())
  conversationId String
  type           SignalType
  data           Json
  label          String
  confidence     Float
  createdAt      DateTime     @default(now())
  conversation   Conversation @relation(fields: [conversationId], references: [id])
}

model AudienceEstimate {
  id             String       @id @default(uuid())
  conversationId String       @unique
  estimateLow    Int
  estimateHigh   Int
  reasoning      String
  createdAt      DateTime     @default(now())
  conversation   Conversation @relation(fields: [conversationId], references: [id])
}

model CgFieldLookup {
  id        Int    @id @default(autoincrement())
  fieldName String
  value     String
  label     String

  @@unique([fieldName, value])
  @@map("cg_field_lookup")
}

// Accessed only via $executeRaw / $queryRaw — never via generated client methods.
// Included so Prisma owns the table creation in migrations.
model TaxonomyEmbedding {
  id         Int    @id @default(autoincrement())
  sourceType String // "LOCATION" | "TRANSACTION" | "CG"
  label      String
  data       Json
  textChunk  String
  embedding  Unsupported("vector(1024)")?

  @@map("taxonomy_embeddings")
}
